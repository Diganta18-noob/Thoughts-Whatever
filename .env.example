# ─── Database ───────────────────────────────────────────────
# Local Postgres, or a hosted one (Neon / Supabase / Railway)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/thoughts_whatever?schema=public"

# ─── Admin auth ─────────────────────────────────────────────
# Sign the admin session cookie. Any long random string.
#   openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-long-random-string"

# There is no admin account here, and no sign-up page on the site. Create the
# single account with database access instead:
#   npm run admin:hash -- you@example.com "your password" "আপনার নাম"

# ─── Site ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Thoughts Whatever"
NEXT_PUBLIC_INSTAGRAM="https://www.instagram.com/thoughts.whatever_/"

# ─── Cloudinary ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── OpenAI & Groq (Audio Transcription) ─────────────────
GROQ_API_KEY="gsk_your-groq-api-key"
OPENAI_API_KEY="sk-proj-your-openai-api-key"

# ─── Cloudflare R2 (Backup Storage) ─────────────────────
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BACKUP_BUCKET_NAME="thoughts-whatever-backups"

# ─── Email Notifications ────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-app-password"
NOTIFICATION_EMAIL_TO="admin@example.com"

# ─── System Maintenance ─────────────────────────────────
MAINTENANCE_TIMEZONE="Asia/Kolkata"
LOG_RETENTION_DAYS="90"
MIN_DISK_SPACE_PERCENT="20"

# ─── PostHog Analytics ──────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY="phc_your-posthog-project-key"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"




# Universal Prompt Storage System API Key for External Tools (Kiro, Antigravity, CLI)
PROMPT_API_KEY="your-prompt-api-key-here"
