// ─── Thoughts Whatever — Prisma Schema ─────────────────────────
// Bengali literary + documentary publication.
//
// The central idea of the data model: a reel and its full written piece are
// the SAME record. The reel is the trailer, `bodyBn` is the work. Nothing on
// Instagram is the source of truth — this table is.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────

enum PieceKind {
  RACHANA // রচনা — full written companion to a reel
  BLOG // ব্লগ — original longform, not tied to a reel
  DOCUMENTARY // ডকুমেন্টারি — video-led, with sources and a timeline
}

enum PieceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TagKind {
  FORM // কবিতা, ছোটগল্প, প্রবন্ধ, উপন্যাস
  THEME // দেশভাগ, প্রেম, নগরজীবন
  ERA // রেনেসাঁস, ত্রিশের দশক, উত্তর-ঔপনিবেশিক
  TOPIC // catch-all
}

// ─── Content ────────────────────────────────────────────────

model Piece {
  id     String      @id @default(cuid())
  kind   PieceKind
  status PieceStatus @default(DRAFT)
  slug   String      @unique

  // Bengali is the content language; English titles are optional and used
  // only for SEO and for diaspora readers scanning the archive.
  titleBn    String
  titleEn    String?
  subtitleBn String?
  dekBn      String? @db.Text // standfirst / intro line under the title
  bodyBn     String  @db.Text // markdown
  excerptBn  String? @db.Text // auto-derived on save if left empty

  // Media
  coverImage String?
  reelUrl    String? // https://www.instagram.com/reel/XXXX/
  videoUrl   String? // YouTube / Vimeo, for documentary pieces
  audioUrl   String? // আবৃত্তি — reuse of the reel voiceover
  audioSec   Int? // narration length, for the mini-player

  // Reading
  readingMinutes Int     @default(1)
  featured       Boolean @default(false)
  viewCount      Int     @default(0)

  // SEO
  seoDescription String?
  ogImage        String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  authors     Author[]        @relation("PieceAuthors")
  tags        Tag[]           @relation("PieceTags")
  series      Series?         @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  seriesId    String?
  seriesOrder Int?
  sources     Source[]
  timeline    TimelineEvent[]
  analyticsEvents AnalyticsEvent[]

  @@index([kind, status, publishedAt])
  @@index([status, featured])
  @@index([seriesId, seriesOrder])
}

// ─── Analytics ──────────────────────────────────────────────

model AnalyticsEvent {
  id        String   @id @default(cuid())
  pieceId   String?
  eventType String   // "view" | "scroll_25" | "scroll_50" | "scroll_75" | "scroll_100" | "instagram_click" | "reel_click"
  sessionId String   // anonymous browser session
  referrer  String?
  userAgent String?
  metadata  Json?    // { scrollDepth: 75, readingTimeSec: 120 }
  createdAt DateTime @default(now())

  piece Piece? @relation(fields: [pieceId], references: [id], onDelete: SetNull)

  @@index([pieceId, eventType, createdAt])
  @@index([sessionId, createdAt])
  @@index([createdAt])
}

/// A literary figure the work is *about* — রবীন্দ্রনাথ, নজরুল, জীবনানন্দ.
/// These generate /authors/[slug] hub pages automatically from tagging,
/// which is both the best SEO surface and the best binge-reading surface.
model Author {
  id       String  @id @default(cuid())
  slug     String  @unique
  nameBn   String
  nameEn   String?
  era      String? // "১৮৬১–১৯৪১"
  bioBn    String? @db.Text
  portrait String?

  pieces Piece[] @relation("PieceAuthors")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id      String  @id @default(cuid())
  slug    String  @unique
  labelBn String
  labelEn String?
  kind    TagKind @default(TOPIC)

  pieces Piece[] @relation("PieceTags")

  createdAt DateTime @default(now())

  @@index([kind])
}

/// ধারাবাহিক — a multi-part run meant to be read in order.
model Series {
  id         String  @id @default(cuid())
  slug       String  @unique
  titleBn    String
  titleEn    String?
  descBn     String? @db.Text
  coverImage String?

  pieces Piece[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// তথ্যসূত্র — citations on documentary pieces. This is the thing that
/// separates a researched documentary from an aesthetic quote page.
model Source {
  id      String  @id @default(cuid())
  piece   Piece   @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  pieceId String
  label   String // "সুনীল গঙ্গোপাধ্যায়, 'পূর্ব-পশ্চিম', আনন্দ পাবলিশার্স, ১৯৮৯"
  url     String?
  note    String? @db.Text
  order   Int     @default(0)

  @@index([pieceId, order])
}

model TimelineEvent {
  id      String  @id @default(cuid())
  piece   Piece   @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  pieceId String
  year    String // kept as text so "১৯৪৭" or "১৯৪৩–৪৪" both work
  labelBn String
  descBn  String? @db.Text
  order   Int     @default(0)

  @@index([pieceId, order])
}

// ─── Readers ────────────────────────────────────────────────

/// চিঠি — the newsletter list.
model Subscriber {
  id                String    @id @default(cuid())
  email             String    @unique
  nameBn            String?
  confirmed         Boolean   @default(false)
  unsubscribeToken  String    @unique @default(cuid())
  source            String? // where they signed up from
  createdAt         DateTime  @default(now())
  confirmedAt       DateTime?
  unsubscribedAt    DateTime?

  @@index([confirmed])
}

// ─── Admin ──────────────────────────────────────────────────

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  nameBn       String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}
