// ─── Thoughts Whatever — Prisma Schema (MongoDB Atlas) ─────────
// Bengali literary + documentary publication.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────

enum PieceKind {
  RACHANA // রচনা — full written companion to a reel
  BLOG // ব্লগ — original longform, not tied to a reel
  DOCUMENTARY // ডকুমেন্টারি — video-led, with sources and a timeline
}

enum PieceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TagKind {
  FORM // কবিতা, ছোটগল্প, প্রবন্ধ, উপন্যাস
  THEME // দেশভাগ, প্রেম, নগরজীবন
  ERA // রেনেসাঁস, ত্রিশের দশক, উত্তর-ঔপনিবেশিক
  TOPIC // catch-all
}

// ─── Content ────────────────────────────────────────────────

model Piece {
  id     String      @id @default(auto()) @map("_id") @db.ObjectId
  kind   PieceKind
  status PieceStatus @default(DRAFT)
  slug   String      @unique

  titleBn    String
  titleEn    String?
  subtitleBn String?
  dekBn      String?
  bodyBn     String // markdown
  excerptBn  String? // auto-derived on save if left empty

  // Media
  coverImage       String?
  coverImageWidth  Int?
  coverImageHeight Int?
  reelUrl          String? // https://www.instagram.com/reel/XXXX/
  videoUrl         String? // YouTube / Vimeo, for documentary pieces
  audioUrl         String? // আবৃত্তি — reuse of the reel voiceover
  audioSec         Int? // narration length, for the mini-player

  // Reading
  readingMinutes Int     @default(1)
  featured       Boolean @default(false)
  viewCount      Int     @default(0)

  // SEO
  seoDescription String?
  ogImage        String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  authorIds String[] @db.ObjectId
  authors   Author[] @relation(fields: [authorIds], references: [id])

  tagIds String[] @db.ObjectId
  tags   Tag[]    @relation(fields: [tagIds], references: [id])

  series      Series?         @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  seriesId    String?         @db.ObjectId
  seriesOrder Int?

  sources         Source[]
  timeline        TimelineEvent[]
  analyticsEvents AnalyticsEvent[]

  @@index([kind, status, publishedAt])
  @@index([status, featured])
  @@index([seriesId, seriesOrder])
}

// ─── Analytics ──────────────────────────────────────────────

model AnalyticsEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  pieceId   String?  @db.ObjectId
  eventType String // "view" | "scroll_25" | "scroll_50" | "scroll_75" | "scroll_100" | "instagram_click" | "reel_click"
  sessionId String // anonymous browser session
  referrer  String?
  userAgent String?
  metadata  Json? // { scrollDepth: 75, readingTimeSec: 120 }
  createdAt DateTime @default(now())

  piece Piece? @relation(fields: [pieceId], references: [id], onDelete: SetNull)

  @@index([pieceId, eventType, createdAt])
  @@index([sessionId, createdAt])
  @@index([createdAt])
}

/// A literary figure the work is *about* — রবীন্দ্রনাথ, নজরুল, জীবনানন্দ.
model Author {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  slug     String  @unique
  nameBn   String
  nameEn   String?
  era      String? // "১৮৬১–১৯৪১"
  bioBn    String?
  portrait String?

  pieceIds String[] @db.ObjectId
  pieces   Piece[]  @relation(fields: [pieceIds], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  slug    String  @unique
  labelBn String
  labelEn String?
  kind    TagKind @default(TOPIC)

  pieceIds String[] @db.ObjectId
  pieces   Piece[]  @relation(fields: [pieceIds], references: [id])

  createdAt DateTime @default(now())

  @@index([kind])
}

/// ধারাবাহিক — a multi-part run meant to be read in order.
model Series {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  slug             String   @unique
  titleBn          String
  titleEn          String?
  descBn           String?
  coverImage       String?
  coverImageWidth  Int?
  coverImageHeight Int?

  pieces Piece[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// তথ্যসূত্র — citations on documentary pieces.
model Source {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  piece   Piece   @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  pieceId String  @db.ObjectId
  label   String // "সুনীল গঙ্গোপাধ্যায়, 'পূর্ব-পশ্চিম', আনন্দ পাবলিশার্স, ১৯৮৯"
  url     String?
  note    String?
  order   Int     @default(0)

  @@index([pieceId, order])
}

model TimelineEvent {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  piece   Piece   @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  pieceId String  @db.ObjectId
  year    String // kept as text so "১৯৪৭" or "১৯৪৩–৪৪" both work
  labelBn String
  descBn  String?
  order   Int     @default(0)

  @@index([pieceId, order])
}

// ─── Readers ────────────────────────────────────────────────

/// চিঠি — the newsletter list.
model Subscriber {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  email            String    @unique
  nameBn           String?
  confirmed        Boolean   @default(false)
  unsubscribeToken String    @unique @default(cuid())
  source           String? // where they signed up from
  createdAt        DateTime  @default(now())
  confirmedAt      DateTime?
  unsubscribedAt   DateTime?

  @@index([confirmed])
}

// ─── Admin ──────────────────────────────────────────────────

model AdminUser {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  email         String         @unique
  passwordHash  String
  nameBn        String?
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  token       String    @unique
  adminUserId String    @db.ObjectId
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  userAgent   String?
  ipAddress   String?
  revoked     Boolean   @default(false)

  @@index([adminUserId])
  @@index([token, revoked])
}
