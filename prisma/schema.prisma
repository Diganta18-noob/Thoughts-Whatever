enum ProspectStage {
  PROSPECT
  QUALIFIED
  CONTACT_FOUND
  EMAIL_DRAFTED
  SENT
  FOLLOW_UP
  REPLIED
  NEGOTIATION
  LINK_ACQUIRED
  REJECTED
}

model CampaignProspect {
  id             String               @id @default(cuid())
  campaignId     String
  campaign       OutreachCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  opportunityId  String?
  opportunity    BacklinkOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  contactName    String?
  contactEmail   String?
  websiteDomain  String
  targetUrl      String?
  stage          ProspectStage        @default(PROSPECT)
  emailSubject   String?
  emailBody      String?
  approvalStatus String               @default("DRAFT") // "DRAFT" | "APPROVED" | "REJECTED"
  lastSentAt     DateTime?
  nextFollowUpAt DateTime?
  notes          String?
