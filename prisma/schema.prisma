  @@index([websiteDomain])
}

model OutreachMessage {
  id          String           @id @default(cuid())
  prospectId  String
  prospect    CampaignProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  stepNumber  Int              @default(0) // 0: Initial, 1: Follow-up 1, etc.
  type        String           @default("INITIAL") // "INITIAL" | "FOLLOW_UP_1" | "FOLLOW_UP_2" | "FINAL"
  subject     String
  body        String
  sentAt      DateTime?
  deliveredAt DateTime?
  openedAt    DateTime?
  repliedAt   DateTime?
  status      String           @default("DRAFT") // "DRAFT" | "QUEUED" | "SENT" | "FAILED"
  createdAt   DateTime         @default(now())

  @@index([prospectId, stepNumber])
}

