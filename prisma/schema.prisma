enum CampaignType {
  GUEST_POST
  RESOURCE_LINK
  BROKEN_LINK
  BRAND_MENTION
  DIGITAL_PR
  PARTNERSHIP
  LINKABLE_ASSET_PROMOTION
}

enum CampaignStatus {
