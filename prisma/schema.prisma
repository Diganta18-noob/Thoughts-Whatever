  LOW
  MEDIUM
  HIGH
}

model MonitoredBacklink {
  id              String            @id @default(cuid())
  websiteId       String
  website         Website           @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  referringDomain String
  sourceUrl       String
  targetUrl       String
  anchorText      String
  linkType        String            @default("EDITORIAL") // "EDITORIAL" | "GUEST_POST" | "RESOURCE" | "DIRECTORY"
  isFollow        Boolean           @default(true)
  status          BacklinkStatus    @default(ACTIVE)
  riskLevel       BacklinkRiskLevel @default(LOW)
  domainAuthority Int               @default(0)
  trafficEstimate Int               @default(0)
  firstDetectedAt DateTime          @default(now())
  lastCheckedAt   DateTime          @default(now())
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  checks          BacklinkCheck[]

  @@unique([websiteId, sourceUrl, targetUrl])
  @@index([websiteId, status])
  @@index([websiteId, riskLevel])
  @@index([referringDomain])
  @@index([lastCheckedAt])
}

model BacklinkCheck {
  id            String            @id @default(cuid())
  backlinkId    String
  backlink      MonitoredBacklink @relation(fields: [backlinkId], references: [id], onDelete: Cascade)
  statusCode    Int               @default(200)
  foundOnPage   Boolean           @default(true)
  anchorMatched Boolean           @default(true)
  isFollow      Boolean           @default(true)
  checkedAt     DateTime          @default(now())
  message       String?
  createdAt     DateTime          @default(now())

  @@index([backlinkId, checkedAt])
}

