// ─── Thoughts Whatever — Prisma Schema (Supabase PostgreSQL) ─────────
// Bengali literary + documentary publication.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ──────────────────────────────────────────────────

enum PieceKind {
  RACHANA // রচনা — full written companion to a reel
  BLOG // ব্লগ — original longform, not tied to a reel
  DOCUMENTARY // ডকুমেন্টারি — video-led, with sources and a timeline
}

enum PieceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TagKind {
  FORM // কবিতা, ছোটগল্প, প্রবন্ধ, উপন্যাস
  THEME // দেশভাগ, প্রেম, নগরজীবন
  ERA // রেনেসাঁস, ত্রিশের দশক, উত্তর-ঔপনিবেশিক
  TOPIC // catch-all
}

// ─── Content ────────────────────────────────────────────────

model Piece {
  id     String      @id @default(cuid())
  kind   PieceKind
  status PieceStatus @default(DRAFT)
  slug   String      @unique

  titleBn    String
  titleEn    String?
  subtitleBn String?
  dekBn      String?
  bodyBn     String // markdown
  excerptBn  String? // auto-derived on save if left empty

  // Media
  coverImage       String?
  coverImageWidth  Int?
  coverImageHeight Int?
  reelUrl          String? // https://www.instagram.com/reel/XXXX/
  videoUrl         String? // YouTube / Vimeo, for documentary pieces
  audioUrl         String? // আবৃত্তি — reuse of the reel voiceover
  audioSec         Int? // narration length, for the mini-player

  // Reading
  readingMinutes Int     @default(1)
  featured       Boolean @default(false)
  viewCount      Int     @default(0)

  // SEO
  seoDescription String?
  ogImage        String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Staging & Review (Phase 2)
  previewToken     String?   @unique
  previewExpiresAt DateTime?
  reviewStatus     String?   @default("draft") // "draft" | "in_review" | "approved" | "scheduled" | "published"
  reviewComments   Json?     // Array of { id, authorName, authorEmail, comment, createdAt }

  // Relations
  authors Author[]
  tags    Tag[]

  series      Series? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  seriesId    String?
  seriesOrder Int?

  sources         Source[]
  timeline        TimelineEvent[]
  analyticsEvents AnalyticsEvent[]
  revisions       ArticleRevision[]
  seoScans        SEOScan[]
  brokenLinks     BrokenLink[]

  @@index([kind, status, publishedAt])
  @@index([status, publishedAt])
  @@index([status, featured])
  @@index([seriesId, seriesOrder])
  @@index([previewToken])
  @@index([reviewStatus])
}

// ─── Phase 2: Content Power & Editorial Intelligence ───────

model ArticleRevision {
  id            String    @id @default(cuid())
  pieceId       String
  piece         Piece     @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  version       Int
  titleBn       String
  titleEn       String?
  subtitleBn    String?
  dekBn         String?
  bodyBn        String    // markdown content
  excerptBn     String?
  coverImage    String?
  metadata      Json?     // tags, authors, series, readingMinutes, sources, timeline
  editedBy      String?
  editedByEmail String?
  editedByName  String?
  changeSummary String?
  status        String    @default("DRAFT")
  createdAt     DateTime  @default(now())

  @@index([pieceId, version])
  @@index([pieceId, createdAt])
}

model Media {
  id           String       @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  url          String
  altText      String?
  caption      String?
  uploadedBy   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  usages       MediaUsage[]

  @@index([mimeType])
  @@index([createdAt])
  @@index([filename])
}

model MediaUsage {
  id          String   @id @default(cuid())
  mediaId     String
  media       Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  entityType  String   // "Piece" | "Series" | "Author"
  entityId    String
  field       String   // "coverImage" | "bodyBn" | "portrait"
  entityTitle String?
  createdAt   DateTime @default(now())

  @@unique([mediaId, entityType, entityId, field])
  @@index([mediaId])
  @@index([entityType, entityId])
}

model SEOScan {
  id        String   @id @default(cuid())
  pieceId   String?
  piece     Piece?   @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  url       String
  score     Int      // 0-100
  issues    Json     // array of { type: string, severity: "info" | "warning" | "critical", message: string, field?: string }
  metrics   Json?    // { titleLength, wordCount, headingsCount, imagesWithAlt, brokenLinksCount }
  scannedAt DateTime @default(now())

  @@index([pieceId])
  @@index([scannedAt])
  @@index([score])
}

model BrokenLink {
  id          String   @id @default(cuid())
  url         String
  pieceId     String?
  piece       Piece?   @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  sourceType  String   // "Piece" | "Series" | "Author"
  sourceTitle String?
  statusCode  Int?
  reason      String
  ignored     Boolean  @default(false)
  lastChecked DateTime @default(now())

  @@index([pieceId])
  @@index([sourceType])
  @@index([lastChecked])
  @@index([ignored])
}

// ─── Analytics ──────────────────────────────────────────────

model AnalyticsEvent {
  id        String   @id @default(cuid())
  pieceId   String?
  eventType String // "view" | "scroll_25" | "scroll_50" | "scroll_75" | "scroll_100" | "instagram_click" | "reel_click"
  sessionId String // anonymous browser session
  referrer  String?
  userAgent String?
  metadata  Json? // { scrollDepth: 75, readingTimeSec: 120 }
  createdAt DateTime @default(now())

  piece Piece? @relation(fields: [pieceId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([pieceId, eventType, createdAt])
  @@index([sessionId, createdAt])
  @@index([createdAt])
}

/// A literary figure the work is *about* — রবীন্দ্রনাথ, নজরুল, জীবনানন্দ.
model Author {
  id       String  @id @default(cuid())
  slug     String  @unique
  nameBn   String
  nameEn   String?
  era      String? // "১৮৬১–১৯৪১"
  bioBn    String?
  portrait String?

  pieces Piece[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id      String  @id @default(cuid())
  slug    String  @unique
  labelBn String
  labelEn String?
  kind    TagKind @default(TOPIC)

  pieces Piece[]

  createdAt DateTime @default(now())

  @@index([kind])
}

/// ধারাবাহিক — a multi-part run meant to be read in order.
model Series {
  id               String   @id @default(cuid())
  slug             String   @unique
  titleBn          String
  titleEn          String?
  descBn           String?
  coverImage       String?
  coverImageWidth  Int?
  coverImageHeight Int?

  pieces Piece[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// তথ্যসূত্র — citations on documentary pieces.
model Source {
  id      String  @id @default(cuid())
  piece   Piece   @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  pieceId String
  label   String // "সুনীল গঙ্গোপাধ্যায়, 'পূর্ব-পশ্চিম', আনন্দ পাবলিশার্স, ১৯৮৯"
  url     String?
  note    String?
  order   Int     @default(0)

  @@index([pieceId, order])
}

model TimelineEvent {
  id      String  @id @default(cuid())
  piece   Piece   @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  pieceId String
  year    String // kept as text so "১৯৪৭" or "১৯৪৩–৪৪" both work
  labelBn String
  descBn  String?
  order   Int     @default(0)

  @@index([pieceId, order])
}

// ─── Readers ────────────────────────────────────────────────

/// চিঠি — the newsletter list.
model Subscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  nameBn           String?
  confirmed        Boolean   @default(false)
  unsubscribeToken String    @unique @default(cuid())
  source           String? // where they signed up from
  createdAt        DateTime  @default(now())
  confirmedAt      DateTime?
  unsubscribedAt   DateTime?

  @@index([confirmed])
}

// ─── Admin ──────────────────────────────────────────────────

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  SEO_MANAGER
  CONTENT_WRITER
  OUTREACH_MANAGER
  EDITOR
  AUTHOR
  ANALYST
  VIEWER
}

model AdminUser {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  nameBn              String?
  role                AdminRole            @default(ADMIN)
  status              String               @default("active") // "active" | "inactive" | "suspended"
  lastActiveAt        DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  notifications       Notification[]
  activities          Activity[]
  dashboardLayout     DashboardLayout?
}

model Permission {
  id        String    @id @default(cuid())
  role      AdminRole
  resource  String    // "content" | "analytics" | "system" | "users" | "security" | "settings"
  action    String    // "create" | "read" | "update" | "delete" | "export" | "manage"
  granted   Boolean   @default(true)

  @@unique([role, resource, action])
  @@index([role])
}

model Notification {
  id          String     @id @default(cuid())
  type        String     // "content_warning" | "system_alert" | "security" | "job_failure" | "seo_issue" | "info"
  severity    String     @default("info") // "info" | "warning" | "critical"
  title       String
  message     String
  read        Boolean    @default(false)
  actionUrl   String?
  metadata    Json?
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  readAt      DateTime?

  @@index([adminUserId, read, createdAt])
  @@index([severity, createdAt])
  @@index([createdAt])
}

model Activity {
  id         String     @id @default(cuid())
  type       String     // "article.created" | "article.published" | "backup.completed" | "user.login" etc.
  actorId    String?
  actorEmail String?
  actorName  String?
  summary    String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime   @default(now())
  adminUser  AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([actorId, createdAt])
}

model DashboardLayout {
  id          String    @id @default(cuid())
  adminUserId String    @unique
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  widgets     Json      // [{ id: "metrics", type: "metrics", position: 0, size: "full", enabled: true }]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PasswordResetToken {
  id                 String    @id @default(cuid())
  tokenHash          String    @unique
  adminUserId        String
  adminUser          AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt          DateTime
  usedAt             DateTime?
  createdAt          DateTime  @default(now())
  requestedIp        String?
  requestedUserAgent String?

  @@index([adminUserId])
}

model RefreshToken {
  id          String    @id @default(cuid())
  token       String    @unique
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  userAgent   String?
  ipAddress   String?
  revoked     Boolean   @default(false)

  @@index([adminUserId])
  @@index([token, revoked])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  adminEmail String
  adminName  String?
  action     String
  entityType String?
  entityId   String?
  entitySlug String?
  summary    String
  changes    Json?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  severity   String   @default("info")
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([severity, createdAt])
  @@index([createdAt])
}

model PromptLog {
  id        String   @id @default(cuid())
  text      String
  summary   String?
  source    String   @default("manual") // "kiro" | "antigravity" | "manual" | "other"
  category  String   @default("other")  // "feature" | "design" | "bug" | "plan" | "question" | "other"
  status    String   @default("idea")   // "idea" | "planned" | "in-progress" | "done" | "rejected"
  tags      String[]
  linkedTo  String?
  notes     String?
  adminId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source, createdAt])
  @@index([status, createdAt])
  @@index([category, createdAt])
  @@index([createdAt])
}

// ─── Phase 3: Analytics, Intelligence & Goal Tracking ───────

model Goal {
  id           String   @id @default(cuid())
  title        String
  metricKey    String   // "pageviews" | "articles_published" | "subscribers" | "avg_reading_time" | "seo_score"
  targetValue  Float
  currentValue Float    @default(0)
  unit         String   @default("count") // "count" | "minutes" | "percent" | "score"
  period       String   @default("monthly") // "weekly" | "monthly" | "quarterly" | "annual"
  startDate    DateTime @default(now())
  endDate      DateTime
  owner        String?
  status       String   @default("ON_TRACK") // "ON_TRACK" | "AT_RISK" | "BEHIND"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([metricKey])
  @@index([status])
  @@index([endDate])
}

// ─── Phase 5: Infrastructure & DevOps ────────────────────────

enum JobStatus {
  IDLE
  RUNNING
  SUCCESS
  FAILED
  PAUSED
}

model ScheduledJob {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  schedule    String         // Cron expression or human interval, e.g. "0 1 * * *"
  status      JobStatus      @default(IDLE)
  enabled     Boolean        @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  lastStatus  String?        // "SUCCESS" | "FAILED" | "WARNING"
  lastDurationMs Int?
  executions  JobExecution[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([enabled])
}

model JobExecution {
  id          String       @id @default(cuid())
  jobId       String
  job         ScheduledJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status      String       // "SUCCESS" | "FAILED" | "WARNING" | "RUNNING"
  durationMs  Int?
  logs        Json?        // Array of log strings or step objects
  error       String?
  startedAt   DateTime     @default(now())
  completedAt DateTime?

  @@index([jobId, startedAt])
  @@index([status])
}

enum IncidentSeverity {
  INFO
  WARNING
  CRITICAL
}

enum IncidentStatus {
  DETECTED
  INVESTIGATING
  RESOLVED
}

model Incident {
  id           String           @id @default(cuid())
  title        String
  description  String?
  severity     IncidentSeverity @default(WARNING)
  status       IncidentStatus   @default(DETECTED)
  affectedArea String           // "database" | "api" | "storage" | "backups" | "security" | "cron"
  assignedTo   String?
  timeline     Json?            // Array of { timestamp, message, author }
  rootCause    String?
  resolution   String?
  detectedAt   DateTime         @default(now())
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([severity, status])
  @@index([status])
  @@index([detectedAt])
}

model APIKey {
  id          String    @id @default(cuid())
  name        String
  keyPrefix   String    // e.g. "tw_live_abc"
  keyHash     String    @unique
  scopes      String[]  // ["content.read", "content.write", "analytics.read", "system.manage"]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revoked     Boolean   @default(false)
  createdBy   String?
  createdAt   DateTime  @default(now())

  @@index([keyPrefix])
  @@index([revoked])
}

model Webhook {
  id          String            @id @default(cuid())
  name        String
  url         String
  secret      String            // Secret for signing HMAC-SHA256 headers
  events      String[]          // ["article.created", "article.published", "backup.completed", etc.]
  active      Boolean           @default(true)
  deliveries  WebhookDelivery[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([active])
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  webhookId    String
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  payload      Json
  statusCode   Int?
  responseBody String?
  durationMs   Int?
  status       String   // "SUCCESS" | "FAILED" | "PENDING"
  createdAt    DateTime @default(now())

  @@index([webhookId, createdAt])
  @@index([status])
}

enum ExportFormat {
  CSV
  JSON
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ExportJob {
  id         String       @id @default(cuid())
  entityType String       // "PIECES" | "ANALYTICS" | "SUBSCRIBERS" | "AUDIT_LOGS" | "SEO_REPORTS" | "MEDIA"
  format     ExportFormat @default(CSV)
  status     ExportStatus @default(PENDING)
  filters    Json?        // { dateRange: "30d", status: "PUBLISHED" }
  rowCount   Int?
  sizeBytes  Int?
  downloadUrl String?
  error      String?
  createdById String?
  createdAt  DateTime     @default(now())
  completedAt DateTime?

  @@index([entityType])
  @@index([status])
  @@index([createdAt])
}

// ─── Phase 4: Intelligence & Relationships ───────────────────

model ContentRecommendation {
  id            String   @id @default(cuid())
  pieceId       String
  recommendedId String
  score         Float    @default(0)
  reason        String   // "same_taxonomy" | "similar_keywords" | "same_series" | "reader_behavior"
  pinned        Boolean  @default(false)
  excluded      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([pieceId, recommendedId])
  @@index([pieceId, score])
  @@index([recommendedId])
}

model ContentRelationship {
  id        String   @id @default(cuid())
  sourceId  String
  targetId  String
  type      String   // "tag_shared" | "series" | "author" | "recommendation" | "manual"
  weight    Float    @default(1)
  createdAt DateTime @default(now())

  @@unique([sourceId, targetId, type])
  @@index([sourceId])
  @@index([targetId])
}

// ═══════════════════════════════════════════════════════════════
// ─── SEO Growth Engine (Organic Backlinks & SEO Automation) ────
// ═══════════════════════════════════════════════════════════════

model Website {
  id              String   @id @default(cuid())
  name            String
  domain          String   @unique
  homepageUrl     String
  niche           String   // e.g. "Technology, AI, Literature, Development"
  targetCountry   String   @default("US") // e.g. "US", "IN", "GLOBAL"
  targetLanguage  String   @default("en") // e.g. "en", "bn"
  gscConnected    Boolean  @default(false)
  gaConnected     Boolean  @default(false)
  isDefault       Boolean  @default(false)
  favicon         String?
  settings        Json?    // Optional custom website configuration
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  integrations          WebsiteIntegration[]
  pages                 WebsitePage[]
  keywords              Keyword[]
  backlinkOpportunities BacklinkOpportunity[]
  competitors           Competitor[]
  brokenLinks           BrokenLinkOpportunity[]
  brandMentions         BrandMention[]
  campaigns             OutreachCampaign[]
  monitoredBacklinks    MonitoredBacklink[]
  contentAssets         ContentAsset[]
  contentBriefs         ContentBrief[]
  internalLinks         InternalLinkSuggestion[]
  seoIssues             TechnicalSEOIssue[]
  tasks                 SEOTask[]
  reports               SEOReport[]
  aiConversations       AIChatConversation[]

  @@index([domain])
  @@index([isDefault])
  @@index([createdAt])
}

enum IntegrationProvider {
  GOOGLE_SEARCH_CONSOLE
  GOOGLE_ANALYTICS
  AHREFS
  SEMRUSH
  MOZ
  DATAFORSEO
  OPENAI
  RESEND
  SMTP
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  REQUIRES_CONFIG
}

model WebsiteIntegration {
  id          String              @id @default(cuid())
  websiteId   String
  website     Website             @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  provider    IntegrationProvider
  status      IntegrationStatus   @default(DISCONNECTED)
  config      Json?               // Store encrypted/safe metadata or tokens
  lastSyncAt  DateTime?
  error       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([websiteId, provider])
  @@index([websiteId])
  @@index([provider])
}

model WebsitePage {
  id                 String   @id @default(cuid())
  websiteId          String
  website            Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  url                String
  path               String
  title              String?
  statusCode         Int      @default(200)
  wordCount          Int      @default(0)
  internalLinksCount Int      @default(0)
  externalLinksCount Int      @default(0)
  organicTraffic     Int      @default(0)
  lastCrawledAt      DateTime?
  status             String   @default("ACTIVE") // "ACTIVE" | "REDIRECT" | "404" | "ARCHIVED"
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([websiteId, url])
  @@index([websiteId, path])
  @@index([status])
}

enum SearchIntent {
  INFORMATIONAL
  COMMERCIAL
  TRANSACTIONAL
  NAVIGATIONAL
}

model Keyword {
  id               String       @id @default(cuid())
  websiteId        String
  website          Website      @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  keyword          String
  targetUrl        String?
  country          String       @default("US")
  searchEngine     String       @default("google")
  currentPosition  Float?
  previousPosition Float?
  bestPosition     Float?
  searchVolume     Int          @default(0)
  difficulty       Int          @default(0) // 0-100
  intent           SearchIntent @default(INFORMATIONAL)
  tags             String[]
  status           String       @default("TRACKING") // "TRACKING" | "PAUSED" | "OPPORTUNITY"
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  rankings         KeywordRanking[]

  @@unique([websiteId, keyword, country, searchEngine])
  @@index([websiteId, currentPosition])
  @@index([difficulty])
}

model KeywordRanking {
  id        String   @id @default(cuid())
  keywordId String
  keyword   Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  position  Float
  url       String?
  recordedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([keywordId, recordedAt])
}

enum OpportunityType {
  RESOURCE_PAGE
  GUEST_POST
  BROKEN_LINK
  UNLINKED_BRAND_MENTION
  COMPETITOR_BACKLINK
  PODCAST
  INTERVIEW
  DIGITAL_PR
  DIRECTORY
  COMMUNITY
  PARTNERSHIP
  SCHOLARSHIP
  TOOL_LISTING
}

enum OpportunityStatus {
  NEW
  RESEARCHING
  QUALIFIED
  CONTACT_FOUND
  READY_FOR_OUTREACH
  CONTACTED
  FOLLOW_UP_1
  FOLLOW_UP_2
  REPLIED
  NEGOTIATING
  WON
  REJECTED
  LOST
  ARCHIVED
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AIRecommendation {
  PURSUE
  MAYBE
  SKIP
}

model BacklinkOpportunity {
  id                String            @id @default(cuid())
  websiteId         String
  website           Website           @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  websiteName       String
  domain            String
  url               String
  opportunityType   OpportunityType   @default(RESOURCE_PAGE)
  contactName       String?
  contactEmail      String?
  domainAuthority   Int               @default(0) // 0-100
  domainRating      Int               @default(0) // 0-100 (Ahrefs style DR)
  trafficEstimate   Int               @default(0)
  spamScore         Int               @default(0) // 0-100
  topicalRelevance  Int               @default(0) // 0-100
  country           String            @default("US")
  language          String            @default("en")
  status            OpportunityStatus @default(NEW)
  priority          PriorityLevel     @default(MEDIUM)
  overallScore      Int               @default(0) // 0-100 calculated score
  aiRecommendation  AIRecommendation  @default(MAYBE)
  aiReasoning       String?
  suggestedAngle    String?
  targetContentUrl  String?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  contacts          OpportunityContact[]
  campaignProspects CampaignProspect[]

  @@index([websiteId, status])
  @@index([websiteId, overallScore])
  @@index([domain])
  @@index([opportunityType])
}

model OpportunityContact {
  id            String              @id @default(cuid())
  opportunityId String
  opportunity   BacklinkOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  name          String
  email         String?
  role          String?             // e.g. "Editor", "Author", "Founder", "Content Lead"
  linkedinUrl   String?
  twitterUrl    String?
  status        String              @default("ACTIVE")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([opportunityId])
}

model Competitor {
  id                    String             @id @default(cuid())
  websiteId             String
  website               Website            @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  name                  String
  domain                String
  organicTraffic        Int                @default(0)
  backlinksCount        Int                @default(0)
  referringDomainsCount Int                @default(0)
  topKeywordsCount      Int                @default(0)
  notes                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  metrics               CompetitorMetric[]

  @@unique([websiteId, domain])
  @@index([websiteId])
}

model CompetitorMetric {
  id                    String     @id @default(cuid())
  competitorId          String
  competitor            Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  organicTraffic        Int        @default(0)
  backlinksCount        Int        @default(0)
  referringDomainsCount Int        @default(0)
  recordedAt            DateTime   @default(now())
  createdAt             DateTime   @default(now())

  @@index([competitorId, recordedAt])
}

